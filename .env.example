# Server-only. Use separate GitHub OAuth applications and secrets for local/production.
AUTH_URL=http://localhost:3000
AUTH_GITHUB_ID=<github-oauth-client-id>
AUTH_GITHUB_SECRET=<github-oauth-client-secret>
AUTH_SECRET=<at-least-32-random-bytes>
# Numeric GitHub IDs, comma-separated; blank grants nobody owner access.
GITHUB_SUPER_ADMIN_IDS=
# Optional organization login and team slug; org alone permits active org members.
GITHUB_EDITOR_ORG=
GITHUB_EDITOR_TEAM=
