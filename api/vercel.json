{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/api-settings.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.caddeltai.com https://*.smdeltart.com https://*.vercel.app http://localhost:* http://127.0.0.1:*"
        },
        { "key": "X-Frame-Options", "value": "ALLOWALL" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/",            "destination": "/api-settings.html" },
    { "source": "/api-settings","destination": "/api-settings.html" },
    { "source": "/settings",    "destination": "/api-settings.html" },
    { "source": "/llama31",     "destination": "/llama31-install-guide.html" }
  ]
}