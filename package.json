{
  "name": "topic-earth",
  "version": "0.1.0",
  "private": true,
  "description": "topic.earth static app with a minimal MCP endpoint for safe ChatGPT tools.",
  "type": "commonjs",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local tools/dev-server.mjs",
    "check:auth": "node --test tests/auth.test.mjs",
    "check:cyclones": "node tools/check-cyclones.mjs",
    "check:captions": "node tools/check-video-captions.mjs",
    "check:solar": "node tools/check-solar-orbits.mjs",
    "check:mcp": "node -c api/mcp.js && node tools/check-mcp-helpers.cjs",
    "audio:read-cache": "node tools/generate-read-audio.mjs",
    "audio:record": "node tools/generate-read-audio.mjs",
    "csv:copy": "node tools/generate-ui-csv-copy.mjs"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vercel/functions": "^3.10.1",
    "zod": "^3.25.76"
  }
}
